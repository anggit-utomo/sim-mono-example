# Copy to .env and fill in. Never commit .env or secrets.
DATABASE_URL=postgresql://sim:sim@localhost:5432/sim
REDIS_HOST=localhost
REDIS_PORT=6379
INGEST_API_KEYS=dev-key-1,dev-key-2
ADMIN_TOKEN=dev-admin-token
WORKER_LANES=fast,cron
FAST_LANE_CONCURRENCY=20
# Training/demo only: hold accepted rows in PENDING this long (ms) before the
# fast-lane worker picks them up. 0 = deliver immediately. Example: 20000.
FAST_LANE_DELAY_MS=0
CRON_TZ=UTC
API_URL=http://localhost:3001
PORT=3001
